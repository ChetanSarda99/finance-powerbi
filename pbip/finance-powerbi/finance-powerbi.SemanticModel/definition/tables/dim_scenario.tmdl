table dim_scenario

	column scenario_code
		dataType: string
		isKey
		sourceColumn: scenario_code
		summarizeBy: none

	column scenario_label
		dataType: string
		sourceColumn: scenario_label
		summarizeBy: none

	column fill_style
		dataType: string
		sourceColumn: fill_style
		summarizeBy: none

	partition dim_scenario = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\dim_scenario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				Typed = Table.TransformColumnTypes(Promoted, {
					{"scenario_code", type text},
					{"scenario_label", type text},
					{"fill_style", type text}
				})
			in
				Typed
