table dim_business_unit

	column business_unit_key
		dataType: int64
		isKey
		sourceColumn: business_unit_key
		summarizeBy: none

	column business_unit_name
		dataType: string
		sourceColumn: business_unit_name
		summarizeBy: none

	partition dim_business_unit = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\dim_business_unit.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				Typed = Table.TransformColumnTypes(Promoted, {
					{"business_unit_key", Int64.Type},
					{"business_unit_name", type text}
				})
			in
				Typed
