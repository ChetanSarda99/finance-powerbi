table fact_capital_finance

	column project_program_name
		dataType: string
		sourceColumn: project_program_name
		summarizeBy: none

	column account_key
		dataType: int64
		sourceColumn: account_key
		summarizeBy: none

	column period_key
		dataType: int64
		sourceColumn: period_key
		summarizeBy: none

	column costcenter_key
		dataType: int64
		sourceColumn: costcenter_key
		summarizeBy: none

	column business_unit_key
		dataType: int64
		sourceColumn: business_unit_key
		summarizeBy: none

	column scenario
		dataType: string
		sourceColumn: scenario
		summarizeBy: none

	column amount
		dataType: double
		sourceColumn: amount
		summarizeBy: sum

	/// Total amount across the current filter context. Foundation for all variance work.
	measure 'Total Amount' = SUM ( fact_capital_finance[amount] )
		formatString: "$#,0;-$#,0;$0"

	/// Actuals - filtered to scenario=AC
	measure Actual = CALCULATE ( [Total Amount], dim_scenario[scenario_code] = "AC" )
		formatString: "$#,0;-$#,0;$0"

	/// Plan = the FY2026 capital-plan allocation (scenario PL, account city_led_alloc_approved_budget).
	/// Same account as Actual, so Plan and Actual compare like-for-like. The separate FY2026 annual
	/// expenditure budget is its own measure and is never added in.
	measure Plan =
			CALCULATE (
			    [Total Amount],
			    dim_scenario[scenario_code] = "PL",
			    dim_account[account_code] = "city_led_alloc_approved_budget"
			)
		formatString: "$#,0;-$#,0;$0"

	/// Forecast - filtered to scenario=FC
	measure Forecast = CALCULATE ( [Total Amount], dim_scenario[scenario_code] = "FC" )
		formatString: "$#,0;-$#,0;$0"

	/// Prior year actual = Actual shifted one fiscal year back. Explicit shift on
	/// dim_period[period_key] because this model is year-grain only (no Date table),
	/// so DATEADD / SAMEPERIODLASTYEAR are not available.
	measure 'Prior Year' =
			CALCULATE (
			    [Actual],
			    FILTER (
			        ALL ( dim_period ),
			        dim_period[period_key] = MAX ( dim_period[period_key] ) - 1
			    )
			)
		formatString: "$#,0;-$#,0;$0"

	/// Running total of Actual across fiscal years, up to and including the selected year.
	/// Not a within-year YTD: the model is annual grain.
	measure 'Actual Cumulative' =
			CALCULATE (
			    [Actual],
			    FILTER ( ALL ( dim_period ), dim_period[period_key] <= MAX ( dim_period[period_key] ) )
			)
		formatString: "$#,0;-$#,0;$0"

	/// The capital-plan allocation for the year: Actual for elapsed years (FY2023-25), Plan for FY2026.
	/// One account in every year, so any two years compare like-for-like.
	measure 'Actual or Plan' = [Actual] + [Plan]
		formatString: "$#,0;-$#,0;$0"

	/// Actual or Plan minus Prior Year. Blank when the year before has no approved budget at all.
	measure 'Variance Abs (vs PY)' =
			VAR c = [Actual or Plan]
			VAR p = [Prior Year]
			VAR pyExists = NOT ISBLANK ( CALCULATE ( [Prior Year], ALL ( dim_business_unit ), ALL ( dim_costcenter ) ) )
			RETURN
			    IF ( pyExists && NOT ( ISBLANK ( c ) && ISBLANK ( p ) ), c - p )
		formatString: "$#,0;-$#,0;$0"

	/// Same change as a percent of Prior Year.
	measure 'Variance Pct (vs PY)' = DIVIDE ( [Actual or Plan] - [Prior Year], [Prior Year] )
		formatString: "0.0%;-0.0%;0.0%"

	/// FY2026 annual capital expenditure budget (capital project budget dataset). A different budget line
	/// from the capital-plan allocation; shown on its own page with the FY2027-30 forecast.
	measure 'Expenditure Budget' =
			CALCULATE ( [Total Amount], dim_account[account_code] = "annual_capital_expenditure_budget" )
		formatString: "$#,0;-$#,0;$0"

	/// Forecast for FY2027 only: the city's published FY2027 expected spending. Compared with the FY2026
	/// expenditure budget, one year on one year.
	measure 'Forecast FY2027' =
			CALCULATE ( [Forecast], dim_period[period_key] = 2027 )
		formatString: "$#,0;-$#,0;$0"

	/// FY2027 forecast minus FY2026 expenditure budget (both expected spending on approved projects).
	measure 'Expenditure Change (FY27 vs FY26)' = [Forecast FY2027] - [Expenditure Budget]
		formatString: "$#,0;-$#,0;$0"

	/// Same change as a percent of the FY2026 expenditure budget.
	measure 'Expenditure Change % (FY27 vs FY26)' = DIVIDE ( [Forecast FY2027] - [Expenditure Budget], [Expenditure Budget] )
		formatString: "0.0%;-0.0%;0.0%"

	/// Year label for axis (so we can show "FY2026" not just "2026")
	measure 'Year Label' = SELECTEDVALUE ( dim_period[label] )

	/// Scenario label for column headers (Actual / Plan / Forecast)
	measure 'Scenario Label' = SELECTEDVALUE ( dim_scenario[scenario_label] )

	/// What share of total this category contributes
	measure 'Category Share Pct' = DIVIDE ( [Actual], CALCULATE ( [Actual], ALL ( dim_costcenter ) ) )
		formatString: "0.0%;-0.0%;0.0%"

	/// Running total across the service-category hierarchy (Pareto-style)
	measure 'Cumulative Share Pct' =
			VAR currentTotal = [Actual]
			VAR cumulative =
			    CALCULATE (
			        [Actual],
			        FILTER (
			            ALL ( dim_costcenter ),
			            CALCULATE ( [Actual] ) >= currentTotal
			        )
			    )
			RETURN
			    DIVIDE ( cumulative, CALCULATE ( [Actual], ALL ( dim_costcenter ) ) )
		formatString: "0.0%;-0.0%;0.0%"

	partition fact_capital_finance = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "\fact_capital_finance.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				Typed = Table.TransformColumnTypes(Promoted, {
					{"project_program_name", type text},
					{"account_key", Int64.Type},
					{"period_key", Int64.Type},
					{"costcenter_key", Int64.Type},
					{"business_unit_key", Int64.Type},
					{"scenario", type text},
					{"amount", type number}
				})
			in
				Typed
